{
  "name": "@fractal-life/simulation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./research": "./src/research/index.ts",
    "./research/registry": "./src/research/experimentRegistry.ts",
    "./substrates": "./src/substrates/index.ts"
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs",
    "test:fast": "node ../../scripts/run-tests.mjs --fast",
    "test:slow": "node ../../scripts/run-tests.mjs --slow",
    "test:record": "node ../../scripts/run-tests.mjs --record",
    "terminal": "tsx src/tui.ts",
    "enrich": "tsx src/research/enrich.ts",
    "research": "tsx src/research/cli.ts",
    "research:events": "tsx src/research/eventRun.ts",
    "research:atlas": "tsx src/research/atlasRun.ts",
    "research:radar": "tsx src/research/radarRun.ts",
    "research:ladder": "tsx src/research/ladderCli.ts",
    "research:bench": "tsx src/research/benchmarks/benchRun.ts",
    "research:known": "tsx src/research/benchmarks/knownRun.ts",
    "research:rigor": "tsx src/research/benchmarks/rigor/rigorRun.ts",
    "research:scope": "tsx src/research/scopeRun.ts",
    "research:ai": "tsx src/research/aiRun.ts",
    "research:experiment": "tsx src/research/experimentCli.ts",
    "research:highn": "tsx src/research/highN.ts",
    "research:life": "tsx src/research/lifeRun.ts",
    "research:ews": "tsx src/research/ewsRun.ts",
    "research:multiverse": "tsx src/research/multiverseRun.ts",
    "research:ablation": "tsx src/research/ablationRun.ts",
    "research:doomsday": "tsx src/research/doomsdayRun.ts",
    "research:selfattack": "tsx src/research/selfAttackRun.ts",
    "research:killswitch": "tsx src/research/killSwitchRun.ts",
    "research:collapse": "tsx src/research/collapsePredictRun.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fractal-life/shared": "1.0.0"
  }
}