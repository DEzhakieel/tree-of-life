{
  "name": "@fractal-life/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-tests.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@fractal-life/shared": "1.0.0",
    "@fractal-life/simulation": "1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.2",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "uWebSockets.js": "^20.44.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.22.8",
    "tsup": "^8.1.0"
  }
}